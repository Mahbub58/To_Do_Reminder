<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/item"
    android:background="@drawable/item_background"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/it"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginRight="5dp"
          android:layout_weight=".2">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical">

              <TextView
                  android:id="@+id/tvid"
                  android:layout_width="wrap_content"
                  android:singleLine="true"
                  android:layout_height="wrap_content"
                  android:text="TextView"
                  android:textSize="0dp"
                  android:visibility="invisible"
                  android:textStyle="bold"
                  style="@style/TextAppearance.AppCompat.Body1"/>
              <TextView
                  android:layout_marginLeft="8dp"
                  android:id="@+id/tvuser"
                  android:layout_width="match_parent"
                  android:singleLine="true"
                  android:layout_height="wrap_content"
                  android:text="TextView"
                  android:textStyle="bold"
                  style="@style/TextAppearance.AppCompat.Title"/>

              <TextView
                  android:layout_marginLeft="8dp"
                  android:layout_marginTop="3dp"
                  android:id="@+id/tvpass"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="TextView"
                  android:textStyle="normal"
                   style="@style/TextAppearance.AppCompat.Body1" />
              <TextView
                  android:id="@+id/ntfy"
                  android:layout_width="wrap_content"
                  android:layout_height="0dp"
                  android:maxLines="2"
                  android:text="Sound and Vivaret"/>
          </LinearLayout>
      </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight=".7">

            <LinearLayout
                android:layout_centerVertical="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                            <TextView
                                android:id="@+id/time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/TextAppearance.AppCompat.Title"
                                android:text="12:13"
                                android:textStyle="bold"/>
                            <TextView
                                android:visibility="visible"
                                android:id="@+id/am_pm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/TextAppearance.AppCompat.Body1"
                                android:text="AM"
                                android:textStyle="bold"/>

                     <TextView
                         android:id="@+id/repet"
                         android:layout_width="wrap_content"
                         android:layout_height="0dp"
                         android:text="Repet"
                         style="@style/TextAppearance.AppCompat.Body1"/>



            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>
    <TextView
        android:layout_below="@+id/it"
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:layout_marginTop="3dp"
        android:layout_centerHorizontal="true"
        style="@style/TextAppearance.AppCompat.Body1"
        android:text="2020-02-20"/>

    <net.cachapa.expandablelayout.ExpandableLayout
        android:id="@+id/expandable_layout"
        android:layout_below="@+id/date"
        android:layout_marginTop="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/expandablelayout_item"
        android:layout_marginBottom="5dp"
        app:el_duration="300"
        app:el_expanded="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:gravity="center_vertical"
                android:layout_centerVertical="true"
                android:orientation="horizontal">
                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/completetask"
                    android:layout_marginLeft="5dp"/>

                <TextView
                    android:id="@+id/taskstatus"
                    style="@style/TextAppearance.AppCompat.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Complete"
                    android:textColor="#000"/>

            </LinearLayout>
            <LinearLayout
                android:layout_gravity="end"
                android:gravity="end"
                android:layout_alignParentEnd="true"
                android:layout_alignParentLeft="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentRight="true">
                <ImageButton
                    android:drawableLeft="@drawable/ic_edit_black_24dp"
                    android:background="@drawable/textview"
                    android:id="@+id/buUpdate"
                    android:src="@drawable/ic_edit_black_24dp"
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit" />
                <ImageButton
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="5dp"
                    android:id="@+id/cancel"
                    android:src="@drawable/ic_cancel_black_24dp"
                    android:drawableLeft="@drawable/ic_cancel_black_24dp"
                    android:background="@drawable/textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delete"
                    android:padding="10dp"/>
                <ImageButton
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="5dp"
                    android:id="@+id/budelet"
                    android:src="@drawable/ic_delete_black_24dp"
                    android:drawableLeft="@drawable/ic_delete_black_24dp"
                    android:background="@drawable/textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delete"
                    android:padding="10dp"/>
            </LinearLayout>
        </RelativeLayout>


    </net.cachapa.expandablelayout.ExpandableLayout>





</RelativeLayout>