<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">
    <ImageView
        android:layout_margin="8dp"
        android:id="@+id/cImage"
        android:src="@drawable/reminder_icon"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="60dp"
        android:layout_centerHorizontal="true"
        android:layout_height="60dp"
        android:text=""/>

    <LinearLayout
        android:id="@+id/titleLayout"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="6dp"
        android:layout_below="@id/cImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/etitle"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Task Name"
            style="@style/TextAppearance.AppCompat.Title"
            android:textColor="@android:color/black"
            android:textStyle="bold"/>
        <TextView
            android:gravity="center_horizontal"
            android:id="@+id/edesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Access deny"
            style="@style/TextAppearance.AppCompat.Body1"
            android:textColor="@android:color/black"
            android:textStyle="normal"/>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/buttonlyout"
        android:layout_below="@+id/titleLayout"
        android:layout_width="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_height="wrap_content"
       android:gravity="center_horizontal"
        android:orientation="horizontal">
        <Button
            android:id="@+id/ecomplete"
            android:text="Complete"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:background="@drawable/btn_background"
            android:drawableLeft="@drawable/ic_check_circle_black_24dp"
            android:layout_width="wrap_content"
            android:paddingRight="5dp"
            android:textColor="@android:color/black"
            android:layout_height="wrap_content"
            />
        <Button
            android:id="@+id/epending"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:text="Pending"
            android:paddingRight="5dp"
            android:background="@drawable/btn_background"
            android:drawableLeft="@drawable/ic_schedule_black_24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            />

        <Button
            android:id="@+id/ecencle"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_background"
            android:drawableLeft="@drawable/ic_cancel_black_24dp"
            android:paddingRight="5dp"
            android:text="Cancel"
            android:textColor="@android:color/black" />

    </LinearLayout>
</RelativeLayout>