<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Tab.taskfinish.taskFinishprivate">

    <androidx.recyclerview.widget.RecyclerView
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/recyclerView"/>

    <RelativeLayout
        android:id="@+id/verify"
        android:layout_centerInParent="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <include layout="@layout/verify"/>
    </RelativeLayout>
    <RelativeLayout
        android:visibility="invisible"
        android:id="@+id/verify2"
        android:layout_centerInParent="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <include layout="@layout/incorectpasswordatempt"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/newset"
        android:visibility="invisible"
        android:layout_centerInParent="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <include layout="@layout/newpasswordset"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/checksecuritycode"
        android:visibility="invisible"
        android:layout_centerInParent="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <include layout="@layout/securitycodecheck"/>
    </RelativeLayout>

</RelativeLayout>